# Copy to .env and fill in. Without a key the app still answers with cited passages only.
LLM_PROVIDER=gemini            # gemini | groq | openrouter | openai | anthropic | none
GEMINI_API_KEY=                # https://aistudio.google.com
# GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=                  # backup when Gemini runs out: https://console.groq.com/keys
# LLM_BACKUP=groq
# OPENROUTER_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1   # provider "openai": Ollama / vLLM
# LLM_MODEL=llama3.1
# ANTHROPIC_API_KEY=
# EMBED_MODEL=snowflake/snowflake-arctic-embed-xs
# RERANK_MODEL=jinaai/jina-reranker-v1-turbo-en   # empty to skip reranking
